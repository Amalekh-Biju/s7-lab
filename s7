                printf " %s > %s %s\n" "$REV$C" "${ITEMS[$i]}" "$R"
            else
                printf "    %s\n" "${ITEMS[$i]}"
            fi
        done
        IFS= read -rsn1 k || exit 0
        if [[ "$k" == $'\x1b' ]]; then
            read -rsn2 -t 0.1 rest || true
            [[ "$rest" == "[A" ]] && sel=$(( (sel - 1 + total) % total ))
            [[ "$rest" == "[B" ]] && sel=$(( (sel + 1) % total ))
        elif [[ "$k" == "" ]]; then
            case "$sel" in
                [0-7]) view_exp_loop "$((sel+1))" "full" ;;
                8)     echo ""; read -r -p "Experiment (1-8) for Commands-Only: " cn; [[ "$cn" =~ ^[1-8]$ ]] && view_exp_loop "$cn" "cmds" ;;
