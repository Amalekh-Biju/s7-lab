[ -f "$ENV_FILE" ] && set -a && source "$ENV_FILE" && set +a
[ -f "$CFG" ] && source "$CFG"

VERCEL_URL="${VERCEL_URL:-${S7_VERCEL_URL:-https://arxec-lab.vercel.app}}"
CF_URL="${CF_URL:-${S7_CF_URL:-}}"
API_KEY="${API_KEY:-${S7_API_KEY:-${GEMINI_API_KEY:-}}}"
ACTIVE_EXP=""

