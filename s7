                [1-8]) view_exp_loop "$k" "full" ;;
                c)     echo ""; read -r -p "Experiment (1-8) for Commands-Only: " cn; [[ "$cn" =~ ^[1-8]$ ]] && view_exp_loop "$cn" "cmds" ;;
