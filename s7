send_ai_query() {
    local q="$1"
    if [ "${q,,}" = "clear" ] || [ "${q,,}" = "/clear" ]; then
        rm -f "$HIST_FILE"
        echo "Conversation history cleared."
        return 0
    fi

    local recent_hist=""
    [ -f "$HIST_FILE" ] && recent_hist=$(tail -n 16 "$HIST_FILE")

    local full_prompt="$LAB_CONTEXT"
    [ -n "$ACTIVE_EXP" ] && full_prompt="$full_prompt
[User is currently viewing Experiment $ACTIVE_EXP]"
    [ -n "$recent_hist" ] && full_prompt="$full_prompt

Recent Conversation History:
$recent_hist"
    full_prompt="$full_prompt

User: $q"

    local ans=""
    for ep in "${VERCEL_URL%/}" "${CF_URL%/}"; do
        [ -z "$ep" ] && continue
        local res
        if res=$(curl -sS --max-time 35 -X POST "$ep/ask" -H "Content-Type: text/plain" ${API_KEY:+-H "X-API-Key: $API_KEY"} --data-raw "$full_prompt" 2>/dev/null) && [ -n "$res" ] && ! [[ "$res" == "[ERROR]"* ]]; then
            ans=$(echo "$res" | clean_output)
            break
        fi
    done

    if [ -z "$ans" ] && [ -n "$API_KEY" ]; then
        local esc_q
        esc_q=$(printf '%s' "$full_prompt" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr '\n' ' ')
        for m in gemini-3.5-flash-lite gemini-3.1-flash-lite gemini-2.5-flash gemma-4-26b-a4b-it; do
            local raw
            raw=$(curl -sS --max-time 25 "https://generativelanguage.googleapis.com/v1beta/models/${m}:generateContent?key=${API_KEY}" \
                -H "Content-Type: application/json" \
                -d "{\"contents\":[{\"parts\":[{\"text\":\"${esc_q}\"}]}]}" 2>/dev/null || true)
            if echo "$raw" | grep -q '"text"'; then
                ans=$(echo "$raw" | tr '\n' ' ' | grep -o '"text"[[:space:]]*:[[:space:]]*"\([^"\\]\|\\.\)*"' | tail -n 1 | sed 's/^"text"[[:space:]]*:[[:space:]]*"//; s/"$//' | clean_output)
                break
            fi
        done
    fi

    if [ -n "$ans" ]; then
        printf "%s\n" "$ans"
        {
            printf "User: %s\n" "$q"
            printf "Assistant: %s\n" "$(echo "$ans" | tr '\n' ' ' | cut -c 1-400)"
        } >> "$HIST_FILE"
        return 0
    fi

    echo "Error: Set your proxy URL via './s7 cfg --vercel <URL>' (or set GEMINI_API_KEY in .env)." >&2
    return 1
}

ask_ai() {
    if [ $# -gt 0 ] && [ -n "$*" ]; then
        send_ai_query "$*"
        return $?
    fi
    printf "%sContinuous AI Chat%s %s(Lab context active • type 'clear' to reset history, 'q' to exit)%s\n" "$B$C" "$R" "$D" "$R"
    while true; do
        read -r -p "${B}${C}ai${ACTIVE_EXP:+ (exp $ACTIVE_EXP)}> ${R}" q || break
        [ -z "$q" ] && continue
        [[ "${q,,}" =~ ^(q|quit|exit|b|back)$ ]] && break
        send_ai_query "$q"
        echo ""
    done
}

search_exps() {
    local kw="$*"
    [ -z "$kw" ] && read -r -p "${B}${C}search> ${R}" kw
    [ -z "$kw" ] && return 0
    for i in 1 2 3 4 5 6 7 8; do
        local out
        out=$(NO_COLOR=1 show_exp "$i" "full")
        if echo "$out" | grep -qi "$kw"; then
            printf "\n%s[Exp %d]%s\n" "$B$C" "$i" "$R"
            echo "$out" | grep -i --color=always "$kw"
        fi
    done
}

config_proxy() {
    if [ $# -gt 0 ]; then
        while [ $# -gt 0 ]; do
            case "$1" in
                --vercel) VERCEL_URL="${2:-}"; shift 2 ;;
                --cloudflare) CF_URL="${2:-}"; shift 2 ;;
                --key) API_KEY="${2:-}"; shift 2 ;;
                *) shift ;;
            esac
        done
    else
        read -r -p "Vercel URL [$VERCEL_URL]: " v && [ -n "$v" ] && VERCEL_URL="$v"
        read -r -p "Cloudflare URL [$CF_URL]: " c && [ -n "$c" ] && CF_URL="$c"
    fi
    cat > "$CFG" <<EOF
VERCEL_URL="$VERCEL_URL"
CF_URL="$CF_URL"
API_KEY="$API_KEY"
EOF
    echo "Saved to $CFG"
}

view_exp_loop() {
    local curr="$1"
    local mode="${2:-full}"
    while true; do
        ACTIVE_EXP="$curr"
        clear 2>/dev/null || true
        show_exp "$curr" "$mode"
        printf "\n%s[c] cmds-only  [f] full instructions  [n] next  [p] prev  [1-8] jump  [a] AI chat  [h] help  [b] menu  [q] quit%s\n" "$D" "$R"
        read -r -p "${B}${C}exp $curr ($mode)> ${R}" act
        case "${act,,}" in
            c|cmds) mode="cmds" ;;
            f|full) mode="full" ;;
            n|"")   curr=$(( curr < 8 ? curr + 1 : 1 )) ;;
            p)      curr=$(( curr > 1 ? curr - 1 : 8 )) ;;
            [1-8])  curr="$act" ;;
            a|ai)   echo ""; ask_ai ;;
            s)      search_exps ""; read -r -p "${D}[Enter]${R}" _ ;;
            h|help) clear; show_help; read -r -p "${D}[Enter]${R}" _ ;;
            b|m)    ACTIVE_EXP=""; break ;;
            q|quit) exit 0 ;;
        esac
    done
}

