#!/usr/bin/env bash
# s7 — Cyber Security Lab CLI (Pure Bash, zero dependencies)
set -u

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="$DIR/.env"
CFG="$DIR/.s7config"
